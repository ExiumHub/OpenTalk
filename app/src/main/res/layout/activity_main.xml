<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas">

    <!-- Modern Elevated Top Header Bar (60dp) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface_canvas"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left: Squircle Settings / Profile Menu Button -->
        <FrameLayout
            android:id="@+id/btnMainMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_top_icon_btn"
            android:clickable="true"
            android:contentDescription="Settings and Profile"
            android:elevation="1dp"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu_hamburger"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Center: Dynamic Title (Contacts) -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStatusBadge"
            app:layout_constraintStart_toEndOf="@id/btnMainMenu"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Center: Modern Pill Segmented Control [ All | Missed ] (Recents tab) -->
        <LinearLayout
            android:id="@+id/layoutRecentsFilter"
            android:layout_width="160dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_ios_segmented"
            android:orientation="horizontal"
            android:padding="3dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnFilterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ios_segment_active"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilterMissed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Missed"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Right 1: Modern SIP Status Capsule Pill (Keypad & Contacts) -->
        <LinearLayout
            android:id="@+id/btnStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_status_pill"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ready"
                android:textColor="@color/registered_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right 2: 3-Vertical-Dots Overflow Menu Button (Recents tab -> opens Clear History) -->
        <FrameLayout
            android:id="@+id/btnClearHistory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_top_icon_btn"
            android:clickable="true"
            android:contentDescription="More Options"
            android:elevation="1dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_primary" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Active In-Call Quick Return Floating Pill Banner -->
    <LinearLayout
        android:id="@+id/layoutInCallBanner"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_incall_banner"
        android:elevation="3dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_stat_phone_connected"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvInCallBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Call in progress • Tap to return"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_canvas"
        app:layout_constraintBottom_toTopOf="@id/bottomBarDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutInCallBanner" />

    <!-- Subtle Spacer Divider (Preserved for ViewBinding compatibility) -->
    <View
        android:id="@+id/bottomBarDivider"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/bottomDock" />

    <!-- Modern Floating Pill Bottom Navigation Dock -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_floating_dock"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. Recents Tab -->
        <LinearLayout
            android:id="@+id/tabRecents"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivTabRecents"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_recents"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvTabRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Recents"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Dialer Tab (Keypad) -->
        <LinearLayout
            android:id="@+id/tabDialer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivTabDialer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_dialer"
                app:tint="@color/tab_active_fg" />

            <TextView
                android:id="@+id/tvTabDialer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Keypad"
                android:textColor="@color/tab_active_fg"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Contacts Tab -->
        <LinearLayout
            android:id="@+id/tabContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivTabContacts"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_contacts"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvTabContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Contacts"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
