<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_centerInParent="true"
                android:background="#CBD5E1" />

            <FrameLayout
                android:id="@+id/btnDetailClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_action_btn_gray"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </RelativeLayout>

        <!-- Contact Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <FrameLayout
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="AV"
                    android:textColor="@color/primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text=""
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:text="Name / Number" />

            <TextView
                android:id="@+id/tvPhoneNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="+880 1880-835590 • Mobile"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Quick Action Buttons Row (Call, Save, Copy, Block — Icon Only, Slightly Closer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="36dp">

            <!-- 1. Call -->
            <LinearLayout
                android:id="@+id/btnDetailCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_call_button">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Call"
                        android:src="@drawable/ic_phone"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. Save Contact -->
            <LinearLayout
                android:id="@+id/btnDetailSaveContact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_btn_blue">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Save Contact"
                        android:src="@drawable/ic_tab_contacts"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </LinearLayout>

            <!-- 3. Copy -->
            <LinearLayout
                android:id="@+id/btnDetailCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_btn_gray">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Copy"
                        android:src="@drawable/ic_action_copy"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- 4. Block / Unblock -->
            <LinearLayout
                android:id="@+id/btnDetailBlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/frameDetailBlockCircle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_btn_red">

                    <ImageView
                        android:id="@+id/ivDetailBlockIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Block"
                        android:src="@drawable/ic_block"
                        app:tint="@color/call_red" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Call History Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="CALL LOGS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Call Logs Card Container -->
        <LinearLayout
            android:id="@+id/layoutCallLogsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_input_inset"
            android:orientation="vertical"
            android:paddingVertical="4dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
