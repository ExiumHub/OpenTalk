<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:background="@drawable/bg_call_card_row"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Soft Indigo Initials Avatar Circle -->
    <TextView
        android:id="@+id/tvContactAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar_circle"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="JD"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Name & Number -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="John Doe"
            android:textColor="@color/text_primary"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContactNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="017XXXXXXXX" />
    </LinearLayout>

    <!-- Soft Emerald Circular Quick Call Button -->
    <ImageButton
        android:id="@+id/btnQuickCall"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_quick_call_soft"
        android:contentDescription="Call"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_phone"
        app:tint="@color/call_green_dark" />

</LinearLayout>
