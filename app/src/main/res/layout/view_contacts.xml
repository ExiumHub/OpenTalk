<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_canvas"
    android:orientation="vertical">

    <!-- Elevated Pill Search Bar with 1-Tap Clear Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_canvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <EditText
                android:id="@+id/etSearchContact"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_search_input"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:drawableTint="@color/text_tertiary"
                android:elevation="1dp"
                android:fontFamily="sans-serif"
                android:hint="Search contacts..."
                android:imeOptions="actionSearch"
                android:paddingStart="14dp"
                android:paddingEnd="40dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnClearSearchContact"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="7dp"
                android:contentDescription="Clear Search"
                android:padding="6dp"
                android:src="@drawable/ic_action_delete"
                android:visibility="gone"
                app:tint="@color/text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Modern Empty Contacts State -->
    <LinearLayout
        android:id="@+id/layoutEmptyContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Empty Contacts"
                android:src="@drawable/ic_tab_contacts"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyContactsMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="No Contacts Found"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card-Spaced Modern Contacts List -->
    <ListView
        android:id="@+id/lvContacts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="16dp"
        android:scrollbars="none" />

</LinearLayout>
