<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly enforce HTTPS-only and trust only system root CAs (blocks cleartext HTTP & user-installed MITM proxy certs) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
